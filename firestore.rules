rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "rezigahmedkhodir@gmail.com";
    }

    // ── Licenses ─────────────────────────────────────────────────────────────
    // App can READ (needed for real-time license stream — detects block/revoke)
    // App CANNOT write — all writes go through Cloud Functions (admin SDK)
    // Admin can do everything from the dashboard
    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Activity ──────────────────────────────────────────────────────────────
    match /activity/{activityId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['deviceId','deviceModel','deviceOS','currentLicense','lastActive']);
      allow delete: if isAdmin();
    }
  }
}
